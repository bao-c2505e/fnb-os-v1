# FnB OS V1 — Environment Variables Template
# Copy this file to .env and fill in all values
# NEVER commit .env to the repository
# NEVER share this file with actual values

# ============================================================
# AI PROVIDERS
# ============================================================

# OpenAI (GPT-4o, Codex)
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
OPENAI_ORG_ID=org-YOUR_ORG_ID_HERE
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# ============================================================
# n8n
# ============================================================

N8N_BASE_URL=https://YOUR_N8N_INSTANCE_URL_HERE
N8N_API_KEY=YOUR_N8N_API_KEY_HERE
N8N_WEBHOOK_BASE_URL=https://YOUR_N8N_INSTANCE_URL_HERE/webhook

# ============================================================
# GOOGLE SHEETS
# ============================================================

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Path to service account JSON key file (NEVER put in repo)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE
GOOGLE_SHEET_NAME=FnB OS V1 — Vị Cuốn

# ============================================================
# GOOGLE DRIVE
# ============================================================

GOOGLE_DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_ROOT_FOLDER_ID_HERE
GOOGLE_DRIVE_CONTENT_PACKS_FOLDER_ID=YOUR_CONTENT_PACKS_FOLDER_ID
GOOGLE_DRIVE_DESIGN_BRIEFS_FOLDER_ID=YOUR_DESIGN_BRIEFS_FOLDER_ID
GOOGLE_DRIVE_ADS_PACKS_FOLDER_ID=YOUR_ADS_PACKS_FOLDER_ID

# ============================================================
# TELEGRAM
# ============================================================

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_APPROVAL_CHAT_ID=YOUR_APPROVAL_CHAT_ID_HERE
TELEGRAM_ESCALATION_CHAT_ID=YOUR_ESCALATION_CHAT_ID_HERE

# ============================================================
# GITHUB
# ============================================================

GITHUB_REPO=YOUR_GITHUB_USERNAME/fnb-os-v1
GITHUB_TOKEN=ghp_YOUR_GITHUB_PAT_HERE

# ============================================================
# LANGGRAPH (Phase 3+)
# ============================================================

LANGGRAPH_API_URL=http://localhost:8000
LANGGRAPH_API_KEY=YOUR_LANGGRAPH_API_KEY_HERE

# ============================================================
# APP CONFIG
# ============================================================

BRAND_NAME=Vị Cuốn
ENVIRONMENT=development
LOG_LEVEL=info
TIMEZONE=Asia/Ho_Chi_Minh

# ============================================================
# SOCIAL PLATFORMS (Phase 6+)
# ============================================================

FACEBOOK_PAGE_ID=YOUR_FACEBOOK_PAGE_ID
FACEBOOK_ACCESS_TOKEN=YOUR_FACEBOOK_PAGE_ACCESS_TOKEN
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_ACCESS_TOKEN
ZALO_OA_ACCESS_TOKEN=YOUR_ZALO_OA_ACCESS_TOKEN
