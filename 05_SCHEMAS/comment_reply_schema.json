{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$schema_version": "0.1.0",
  "title": "CommentReply",
  "description": "A comment or inbox reply generated by the Comment Reply Agent",
  "type": "object",
  "required": [
    "reply_id",
    "comment_id",
    "category",
    "sentiment",
    "reply_vi",
    "escalation_flag",
    "confidence_score",
    "requires_human_review",
    "auto_post_safe",
    "generated_at"
  ],
  "properties": {
    "reply_id": {
      "type": "string",
      "description": "Format: VQ-REP-[YYYYMMDD]-[SEQ]"
    },
    "comment_id": { "type": "string" },
    "platform": {
      "type": "string",
      "enum": ["facebook", "tiktok", "instagram", "zalo"]
    },
    "category": {
      "type": "string",
      "enum": ["location", "price", "compliment", "complaint", "delivery", "tag_friend", "other"]
    },
    "sentiment": {
      "type": "string",
      "enum": ["positive", "neutral", "negative"]
    },
    "reply_vi": {
      "type": "string",
      "description": "Vietnamese reply"
    },
    "reply_en": {
      "type": ["string", "null"]
    },
    "escalation_flag": {
      "type": "boolean",
      "description": "True = human must handle, do not auto-reply"
    },
    "escalation_reason": {
      "type": ["string", "null"]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "requires_human_review": { "type": "boolean" },
    "auto_post_safe": {
      "type": "boolean",
      "description": "True only if confidence >= 0.85 AND escalation_flag = false AND category is safe"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "posted", "escalated", "ignored"]
    },
    "posted_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
