{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$schema_version": "0.1.0",
  "title": "CRMFollowup",
  "description": "A CRM follow-up message generated by the CRM Agent",
  "type": "object",
  "required": [
    "crm_message_id",
    "customer_id",
    "channel",
    "message_vi",
    "confidence_score",
    "requires_human_review",
    "status",
    "generated_at"
  ],
  "properties": {
    "crm_message_id": {
      "type": "string",
      "description": "Format: VQ-CRM-[YYYYMMDD]-[SEQ]"
    },
    "customer_id": { "type": "string" },
    "segment": {
      "type": "string",
      "enum": ["new", "active", "at_risk", "lapsed", "vip"]
    },
    "channel": {
      "type": "string",
      "enum": ["zalo", "sms", "email"]
    },
    "trigger": {
      "type": "string",
      "enum": ["post_order", "win_back", "birthday", "loyalty", "campaign"]
    },
    "message_vi": {
      "type": "string",
      "description": "Vietnamese message, max 300 chars for Zalo, 160 for SMS"
    },
    "message_en": {
      "type": ["string", "null"]
    },
    "personalization_notes": {
      "type": "string",
      "description": "How this message was personalized"
    },
    "offer_included": { "type": ["string", "null"] },
    "send_time_suggestion": {
      "type": "string",
      "format": "date-time"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "requires_human_review": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "rejected", "queued", "sent", "failed"]
    },
    "sent_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
