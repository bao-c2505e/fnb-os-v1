{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$schema_version": "0.1.0",
  "title": "AdsPack",
  "description": "An ads pack generated by the Ads Pack Agent",
  "type": "object",
  "required": [
    "ads_pack_id",
    "campaign_id",
    "platform",
    "objective",
    "headline",
    "body_copy",
    "cta_button",
    "audience_brief",
    "budget_note",
    "confidence_score",
    "requires_human_review",
    "status",
    "generated_at"
  ],
  "properties": {
    "ads_pack_id": {
      "type": "string",
      "description": "Format: VQ-ADS-[YYYYMMDD]-[SEQ]"
    },
    "campaign_id": { "type": "string" },
    "platform": {
      "type": "string",
      "enum": ["facebook", "tiktok", "google"]
    },
    "objective": {
      "type": "string",
      "enum": ["awareness", "engagement", "conversion", "traffic"]
    },
    "headline": {
      "type": "string",
      "maxLength": 40,
      "description": "Max 40 characters"
    },
    "body_copy": {
      "type": "string",
      "maxLength": 125,
      "description": "Max 125 characters"
    },
    "cta_button": {
      "type": "string",
      "enum": ["Đặt ngay", "Xem thêm", "Nhắn tin", "Tìm hiểu thêm", "Mua ngay"]
    },
    "audience_brief": {
      "type": "object",
      "required": ["age_range", "location"],
      "properties": {
        "age_range": { "type": "string" },
        "location": { "type": "string" },
        "interests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "behaviors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lookalike_source": { "type": ["string", "null"] }
      }
    },
    "creative_direction": {
      "type": "string",
      "description": "Visual and copy direction for the creative"
    },
    "budget_note": {
      "type": "string",
      "description": "MUST contain placeholder notice — never a real budget"
    },
    "duration_days": { "type": ["integer", "null"] },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "requires_human_review": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "rejected", "ready_for_upload", "live", "paused"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
