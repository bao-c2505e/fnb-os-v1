{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$schema_version": "0.1.0",
  "title": "ContentPack",
  "description": "A social media content pack generated by the Content Agent",
  "type": "object",
  "required": [
    "content_pack_id",
    "campaign_id",
    "platform",
    "caption_vi",
    "hashtags",
    "call_to_action",
    "confidence_score",
    "requires_human_review",
    "status",
    "generated_at"
  ],
  "properties": {
    "content_pack_id": {
      "type": "string",
      "description": "Format: VQ-CP-[YYYYMMDD]-[SEQ]"
    },
    "campaign_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": ["facebook", "tiktok", "instagram", "zalo"]
    },
    "content_pillar": {
      "type": "string",
      "enum": ["product", "promotion", "behind_scenes", "education", "community"]
    },
    "caption_vi": {
      "type": "string",
      "description": "Vietnamese caption, max 300 chars for FB/IG, 150 for TikTok"
    },
    "caption_en": {
      "type": ["string", "null"],
      "description": "Optional English caption"
    },
    "hashtags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 5,
      "maxItems": 10
    },
    "image_brief": {
      "type": "string",
      "description": "Image generation or photographer brief"
    },
    "call_to_action": {
      "type": "string",
      "description": "Clear singular CTA"
    },
    "post_time_suggestion": {
      "type": "string",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Suggested posting time HH:MM"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "qc_pass", "qc_fail", "approved", "rejected", "scheduled", "posted"]
    },
    "qc_score": {
      "type": ["number", "null"]
    },
    "approval_id": {
      "type": ["string", "null"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "scheduled_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
